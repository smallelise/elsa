{
  "name": "elsa",
  "version": "1.0.0",
  "author": "",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p ./tsconfig.json",
    "build:watch": "rimraf dist && tsc -p ./tsconfig.json --watch",
    "dev": "rimraf dist && tsc-watch -p ./tsconfig.json --onSuccess \"node --enable-source-maps --env-file=.env ./dist/index.js\"",
    "type-check": "pnpm run \"/type-check:.*/\"",
    "type-check:test": "tsc -p ./test/tsconfig.json --noEmit",
    "type-check:src": "tsc -p ./tsconfig.json --noEmit"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "immer": "11.1.21",
    "lodash-es": "4.18.1",
    "pandora-api": "github:Project-Pandora-Game/pandora#master&path:pandora-api",
    "pandora-common": "github:Project-Pandora-Game/pandora#master&path:pandora-common",
    "rimraf": "6.1.3",
    "tslib": "2.8.1",
    "wtfnode": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.19.2",
    "@types/wtfnode": "0.10.0",
    "discord-api-types": "0.38.56",
    "tsc-watch": "7.2.1",
    "typescript": "6.0.3"
  }
}